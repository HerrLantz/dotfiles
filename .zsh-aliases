alias ccat='pygmentize -g -O style=emacs'
alias c='clear'
alias now='date +"%T"' alias mv='mv -i'
alias cp='cp -i'
alias ln='ln -i'
alias cd="z"
alias yaa='ls -la | grep'
alias chx='chmod 755'
alias datestring='date +%Y%m%d%H%M'
alias ls='ls -G'
alias date='gdate'
alias gr='cd $(git rev-parse --show-toplevel)'
alias sed='gsed'
alias gcane='git commit --amend --no-edit'
alias grf='git reflog'

alias zshconfig="nvim ~/.zshrc"
alias sauce="source ~/.zshrc"
alias aliases="nvim ~/.zsh-aliases"

alias dc="docker compose"

# Kubernetes
alias kaf="kubectl apply -f"
alias kdp="kubectl delete pod"
alias kgp="kubectl get pods"
alias kl="kubectl logs"
alias kgn="kubectl get ns"

# Python stuff
alias vac="source venv/bin/activate" 
alias deac="deactivate" 
alias urm="uv run manage.py"

# VPN
alias vpn-up="sudo wg-quick up"
alias vpn-down="sudo wg-quick down"

