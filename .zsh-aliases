alias ccat='pygmentize -g -O style=emacs'
alias c='clear'
alias now='date +"%T"'
alias mv='mv -i'
alias cp='cp -i'
alias ln='ln -i'
alias yaa='ls -la | grep'
alias chx='chmod 755'
alias datestring='date +%Y%m%d%H%M'
alias ls='ls -G'
alias date='gdate'
alias gr='cd $(git rev-parse --show-toplevel)'
alias sed='gsed'
alias gcane='git commit --amend --no-edit'

alias zshconfig="nvim ~/.zshrc"
alias aliases="nvim ~/.zsh-aliases"
